# Reverse proxy production (docker-compose.prod.yml). Image nginx render template này thành
# /etc/nginx/conf.d/default.conf khi khởi động, chỉ thay biến có trong environment (${DOMAIN});
# biến của nginx ($host, $remote_addr...) giữ nguyên.
# Chứng chỉ: lần đầu do infra/init-letsencrypt.sh, sau đó container certbot tự gia hạn (webroot bên dưới).

# --- Chống dồn request theo IP: vượt ngưỡng bị trả 429 ngay tại nginx, không tới Java ---
limit_req_zone  $binary_remote_addr zone=quiz_api:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=quiz_web:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=quiz_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# --- HTTP: thử thách Let's Encrypt + chuyển mọi thứ sang https://${DOMAIN} (kể cả www.) ---
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- HTTPS www.${DOMAIN} -> tên miền chính. Chứng chỉ chung với ${DOMAIN}
# (init-letsencrypt.sh tự thêm www khi DNS của www đã trỏ về server).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    return 301 https://${DOMAIN}$request_uri;
}

# --- HTTPS ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'" always;

    client_max_body_size 1m;
    limit_conn quiz_conn 30;

    error_page 429 = @too_many_requests;
    location @too_many_requests {
        default_type application/json;
        add_header Retry-After 5 always;
        return 429 '{"status":429,"message":"Quá nhiều yêu cầu, vui lòng thử lại sau."}';
    }

    # DNS nội bộ Docker, hỏi lại mỗi 10s: deploy tạo lại container với IP mới, proxy_pass dùng biến để nginx
    # phân giải theo từng request (tránh 502 vào IP cũ cho tới khi restart nginx).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $quiz_backend http://backend:8080;
    set $quiz_frontend http://frontend:80;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Health chỉ dùng nội bộ (Docker healthcheck)
    location ~ ^/(api/)?actuator {
        return 404;
    }

    location /api/ {
        limit_req zone=quiz_api burst=40 nodelay;
        proxy_pass $quiz_backend;
        include /etc/nginx/templates/proxy_headers.inc;
        proxy_read_timeout 60s;
    }

    # Còn lại -> bản build React (nginx trong image frontend xử lý route SPA)
    location / {
        limit_req zone=quiz_web burst=100 nodelay;
        proxy_pass $quiz_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
