#!/bin/sh
#
# Pre-commit hook: chặn commit file build và file/nội dung chứa secret.
# Kích hoạt (1 lần sau khi clone):  git config core.hooksPath .githooks
#
# Bỏ qua 1 dòng bị nhận nhầm: thêm comment "gitleaks:allow" vào cuối dòng đó.

FAILED=0
RED=$(printf '\033[31m')
YELLOW=$(printf '\033[33m')
RESET=$(printf '\033[0m')

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# ---------------------------------------------------------------
# 1. Chặn theo tên / đường dẫn file
# ---------------------------------------------------------------
BUILD_PATTERN='(^|/)(target|node_modules|dist|dist-ssr|build|coverage|\.vite|logs)/|\.(class|jar|war|ear|log)$'

SECRET_FILE_PATTERN='(^|/)\.env$|(^|/)\.env\.[^/]+$|\.env$'\
'|\.(pem|key|p8|p12|pfx|jks|keystore|truststore|ppk|der|csr|gpg)$'\
'|(^|/)id_(rsa|dsa|ecdsa|ed25519)[^/]*$'\
'|(^|/)application-(local|secret[^/]*)\.(ya?ml|properties)$'\
'|(^|/)(credentials|client_secret[^/]*|service-account[^/]*)\.json$'\
'|(^|/)(\.npmrc|\.netrc|\.htpasswd)$'\
'|(^|/)(docker-)?compose\.override\.ya?ml$'\
'|\.(sql\.gz|dump|bak)$'

SECRET_FILE_ALLOW='\.(example|sample|template)$'

for f in $STAGED; do
  if echo "$f" | grep -Eq "$BUILD_PATTERN"; then
    echo "${RED}[BLOCKED] File build/artifact:${RESET} $f"
    FAILED=1
  fi
  if echo "$f" | grep -Eq "$SECRET_FILE_PATTERN" && ! echo "$f" | grep -Eq "$SECRET_FILE_ALLOW"; then
    echo "${RED}[BLOCKED] File có thể chứa secret:${RESET} $f"
    FAILED=1
  fi
done

# ---------------------------------------------------------------
# 2. Quét nội dung các dòng được thêm mới
# ---------------------------------------------------------------
CONTENT_PATTERNS='-----BEGIN [A-Z ]*PRIVATE KEY-----'\
'|AKIA[0-9A-Z]{16}'\
'|gh[pousr]_[A-Za-z0-9]{36,}'\
'|github_pat_[A-Za-z0-9_]{50,}'\
'|xox[abprs]-[A-Za-z0-9-]{10,}'\
'|AIza[0-9A-Za-z_-]{35}'\
'|sk-(ant-)?[A-Za-z0-9_-]{32,}'\
'|_authToken=[^$[:space:]]+'\
'|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'\
'|jdbc:[a-z]+://[^[:space:]]*:[^[:space:]$@]+@'

# key = value / key: value với giá trị cứng (không phải ${ENV}) dài >= 8 ký tự.
# Key có ngoặc thì dấu :/= phải đi liền ("password": ...) để không bắt nhầm toán tử 3 ngôi `? 'password' : 'x'`.
ASSIGN_KEY='(password|passwd|pwd|secret|api[_-]?key|access[_-]?key|private[_-]?key|token|jwt[_-]?secret|client[_-]?secret)'
ASSIGN_SEP="([\"']?[:=]|[[:space:]]+[:=])[[:space:]]*"
# File cấu hình: giá trị có thể không có ngoặc (password=abc12345).
ASSIGN_PATTERN_CONFIG="$ASSIGN_KEY$ASSIGN_SEP[\"']?[^[:space:]\"'\$\\{<][^[:space:]\"']{7,}"
# Mã nguồn: chỉ bắt chuỗi literal trong ngoặc, liền mạch (bỏ qua biến/biểu thức như password: e.target.value
# và thông báo lỗi có dấu cách như password: 'Mật khẩu không đúng').
ASSIGN_PATTERN_CODE="$ASSIGN_KEY$ASSIGN_SEP[\"'][^[:space:]\"'\$\\{<][^[:space:]\"']{7,}[\"']"

for f in $STAGED; do
  case "$f" in
    .githooks/*|.gitleaks.toml) continue ;;
  esac
  # bỏ qua file nhị phân
  if git diff --cached --numstat -- "$f" | grep -q '^-'; then
    continue
  fi
  ADDED=$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++' | grep -v 'gitleaks:allow')
  [ -z "$ADDED" ] && continue

  HITS=$(echo "$ADDED" | grep -nE -- "$CONTENT_PATTERNS")
  case "$f" in
    *.yml|*.yaml|*.properties|*.env|*.env.*|*.conf|*.cnf|*.ini|*.cfg|*.toml|*.xml|*.tf|*.tfvars|*.sh|*Dockerfile*)
      ASSIGN_PATTERN="$ASSIGN_PATTERN_CONFIG" ;;
    *)
      ASSIGN_PATTERN="$ASSIGN_PATTERN_CODE" ;;
  esac
  # Bỏ placeholder không mang giá trị: ${VAR}, ${VAR:-}, ${VAR:?thông báo lỗi}. ${VAR:mặc-định} vẫn bị quét.
  ADDED_NO_PLACEHOLDER=$(echo "$ADDED" | sed -E 's/\$\{[A-Za-z0-9_.-]+(:-?|:\?[^}]*)?\}//g')
  HITS2=$(echo "$ADDED_NO_PLACEHOLDER" | grep -niE -- "$ASSIGN_PATTERN")
  if [ -n "$HITS" ] || [ -n "$HITS2" ]; then
    echo "${RED}[BLOCKED] Phát hiện secret trong:${RESET} $f"
    printf '%s\n%s\n' "$HITS" "$HITS2" | grep -v '^$' | cut -c1-160 | sed 's/^/    /'
    FAILED=1
  fi
done

# ---------------------------------------------------------------
# 3. Nếu máy có cài gitleaks thì quét thêm
# ---------------------------------------------------------------
if [ "$FAILED" -eq 0 ] && command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --config .gitleaks.toml -v >/dev/null 2>&1; then
    echo "${RED}[BLOCKED] gitleaks phát hiện secret.${RESET} Chạy: gitleaks protect --staged -v"
    FAILED=1
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "${YELLOW}Commit bị chặn.${RESET} Gỡ file khỏi stage: git restore --staged <file>"
  echo "Dùng biến môi trường (\${DB_PASSWORD}) và file .env (đã ignore) thay vì hard-code."
  echo "Nếu là nhận nhầm, thêm comment 'gitleaks:allow' vào cuối dòng đó."
  exit 1
fi

exit 0
